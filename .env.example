# Get a key at https://serper.dev (2,500 free queries to start).
# Each contractor looked up uses about one credit.
SERPER_API_KEY=

# A reachable contact address, advertised in the crawler's User-Agent.
# This is what makes the crawl defensible if a site owner wants to reach you.
CRAWLER_CONTACT_EMAIL=you@example.com

# Optional and free: a Socrata app token from https://datahub.transportation.gov
# (sign in > Developer settings > Create new app token). Without one the US DOT
# site slows down repeated searches; with one they run at full speed.
SOCRATA_APP_TOKEN=

# Optional email finder (the same keys work for Healthcare LoanScout). The
# email on a US DOT filing is often whoever filled in the form; the finder
# looks up the named officer's own address at the company's domain. Only
# verified addresses are used. Leave blank to run without one.
# Anymailfinder (https://anymailfinder.com): charges only for verified emails.
ANYMAILFINDER_API_KEY=
